# Copy to .env for local development. Never commit real credentials.
PORT=8080
NODE_ENV=development
DB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=90d
JWT_EXPIRES_TIME=90
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_FROM=
FRONTEND_URL=http://localhost:5173
STRIPE_SECRET_KEY=
STRIPE_API_KEY=
GROQ_API_KEY=
